# Habit Tracker Backend Environment Variables

# SQLite database file path (used for zero-setup local development)
# To use PostgreSQL instead, change to:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/habittracker?schema=public"
DATABASE_URL="file:./habittracker.db"

# JWT signing secret — CHANGE THIS before deploying to production
JWT_SECRET="habit_tracker_dev_secret_change_in_production_minimum_32_chars"

# Server port
PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Node environment
NODE_ENV="development"
